# ==========================================
# SCALABLE AUTHENTICATION PLATFORM CONFIG
# ==========================================

# Server Environment
NODE_ENV=development
PORT=4000
INSTANCE_ID=api-primary-1

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://auth_user:auth_secret_password@localhost:5432/scalable_auth_db?schema=public

# Distributed Cache & Queue (Redis)
REDIS_URL=redis://localhost:6379

# Cryptographic Keys (Min 32 characters)
JWT_SECRET=super-secret-jwt-signing-key-production-32-chars!
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super-secret-refresh-token-signing-key-32-chars!
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
COOKIE_SECRET=cookie-secret-encryption-key-for-session-tokens

# Frontend Client Origin
FRONTEND_URL=http://localhost:3000

# Email Delivery Provider (options: mock | resend | smtp)
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@scalableauth.internal
# EMAIL_API_KEY=re_123456789 (for Resend)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@example.com
# SMTP_PASS=your-smtp-password

# Distributed Rate Limiting (Limits per window)
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SEC=60

RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SEC=60

RATE_LIMIT_VERIFY_MAX=5
RATE_LIMIT_VERIFY_WINDOW_SEC=600

RATE_LIMIT_RESEND_MAX=3
RATE_LIMIT_RESEND_WINDOW_SEC=600

RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_REFRESH_WINDOW_SEC=60

# Verification Code Security
VERIFICATION_CODE_EXPIRES_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5
